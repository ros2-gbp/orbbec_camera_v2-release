From 1538c10e4face88e7be96800bbf4a0187fa341da Mon Sep 17 00:00:00 2001
From: ob-yalian <luotao2025@163.com>
Date: Sat, 10 Oct 2026 14:28:10 +0800
Subject: [PATCH] Exclude bundled inference library from shlibdeps

---
 debian/rules | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/debian/rules b/debian/rules
index 4b71b4f..a77f9d7 100755
--- a/debian/rules
+++ b/debian/rules
@@ -57,7 +57,7 @@ override_dh_shlibdeps:
 	# in the install tree and source it.  It will set things like
 	# CMAKE_PREFIX_PATH, PKG_CONFIG_PATH, and PYTHONPATH.
 	if [ -f "/opt/ros/rolling/setup.sh" ]; then . "/opt/ros/rolling/setup.sh"; fi && \
-	dh_shlibdeps -l$(CURDIR)/debian/ros-rolling-orbbec-camera//opt/ros/rolling/lib/:$(CURDIR)/debian/ros-rolling-orbbec-camera//opt/ros/rolling/opt/orbbec_camera/lib/
+	dh_shlibdeps -Xlibengine_infer_encry.so -l$(CURDIR)/debian/ros-rolling-orbbec-camera//opt/ros/rolling/lib/:$(CURDIR)/debian/ros-rolling-orbbec-camera//opt/ros/rolling/opt/orbbec_camera/lib/
 
 override_dh_auto_install:
 	# In case we're installing to a non-standard location, look for a setup.sh
-- 
2.34.1

